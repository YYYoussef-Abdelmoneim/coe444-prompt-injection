# Copy to .env and fill in. Never commit .env.

# ── Cerebras (OpenAI-compatible) ──────────────────────────────────────────────
# The detector runs here, and so does the agent when AGENT_PROVIDER=cerebras.
# BASE_URL is overridable so the same provider class can point at any
# OpenAI-compatible endpoint.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Groq (OpenAI-compatible) ──────────────────────────────────────────────────
# Serves the agent in the split-provider setup; the detector stays on Cerebras.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional. Only needed to reproduce the Claude arm:
#   AGENT_PROVIDER=anthropic AGENT_MODEL=claude-haiku-4-5 \
#   DETECTOR_PROVIDER=anthropic DETECTOR_MODEL=claude-sonnet-5
# Nothing in the pipeline breaks when this is unset.
ANTHROPIC_API_KEY=

# Where heavy artefacts live. Point this at the mounted disk image on the
# external drive; scripts/setup.sh writes the correct value for you.
COE444_DATA_ROOT=/Volumes/COE444/coe444-data

AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-20b
DETECTOR_PROVIDER=cerebras
DETECTOR_MODEL=gpt-oss-120b

# temperature is expressible again on an OpenAI-compatible endpoint; the
# Anthropic Messages API had removed it.
AGENT_TEMPERATURE=0.0

RETRIEVAL_K=4
TRIALS_PER_TASK=3
CORPUS_VERSION=v0.2.1-ridealong

# Free-tier guard for the web UI. After USAGE_WARN_RUNS model runs within
# USAGE_WINDOW_S seconds, the Mailbox page shows a "slow down" banner. Advisory
# only; it never blocks a run. Counts per server process, not per API key.
USAGE_WARN_RUNS=8
USAGE_WINDOW_S=300
