# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Where heavy artefacts live. Point this at the mounted disk image on the
# external drive; scripts/setup.sh writes the correct value for you.
COE444_DATA_ROOT=/Volumes/COE444/coe444-data

AGENT_MODEL=claude-sonnet-5
DETECTOR_MODEL=claude-haiku-4-5
DETECTOR_PROVIDER=anthropic

RETRIEVAL_K=4
TRIALS_PER_TASK=3
CORPUS_VERSION=v0.1-dev
