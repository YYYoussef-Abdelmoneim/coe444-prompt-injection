# Copy to .env and fill in. Never commit .env.

# ── Cerebras (OpenAI-compatible) ──────────────────────────────────────────────
# Historical: hosted the detector until 8 Nov 2026 (HTTP 402 since). Only needed
# to reproduce October logs.
# BASE_URL is overridable so the same provider class can point at any
# OpenAI-compatible endpoint.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Groq (OpenAI-compatible) ──────────────────────────────────────────────────
# Used for the Prompt Guard 2 comparison arm (cli.py detector-eval --promptguard).
# Hosted both models for a few hours on 8 Nov; daily token cap made it unfit for sweeps.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional. Only needed to reproduce the Claude arm:
#   AGENT_PROVIDER=anthropic AGENT_MODEL=claude-haiku-4-5 \
#   DETECTOR_PROVIDER=anthropic DETECTOR_MODEL=claude-sonnet-5
# Nothing in the pipeline breaks when this is unset.
ANTHROPIC_API_KEY=

# Where heavy artefacts live. Point this at the mounted disk image on the
# external drive; scripts/setup.sh writes the correct value for you.
COE444_DATA_ROOT=/Volumes/COE444/coe444-data

# ── Nous Research inference API (OpenAI-compatible) ──────────────────────────
# Serves both models since 8 Nov 2026 (METHODOLOGY 5A). Same model strings as
# Groq/Cerebras; scores differ per host, so every record logs its host.
NOUS_API_KEY=
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

AGENT_PROVIDER=nous
AGENT_MODEL=openai/gpt-oss-20b
# Host history: Cerebras (to 8 Nov 2026, HTTP 402 since) → Groq (hours) → Nous.
# detector-v3a and the 0.10 threshold are unchanged throughout; see
# METHODOLOGY.md 5A. Logs before 8 Nov record detector_model=gpt-oss-120b.
DETECTOR_PROVIDER=nous
DETECTOR_MODEL=openai/gpt-oss-120b
# Verdicts per excerpt; highest kept. 3 adopted 8 Nov 2026 (METHODOLOGY 5A).
DETECTOR_SAMPLES=3

# temperature is expressible again on an OpenAI-compatible endpoint; the
# Anthropic Messages API had removed it.
AGENT_TEMPERATURE=0.0

RETRIEVAL_K=4
TRIALS_PER_TASK=3
CORPUS_VERSION=v0.2.1-ridealong

# Free-tier guard for the web UI. After USAGE_WARN_RUNS model runs within
# USAGE_WINDOW_S seconds, the Mailbox page shows a "slow down" banner. Advisory
# only; it never blocks a run. Counts per server process, not per API key.
USAGE_WARN_RUNS=8
USAGE_WINDOW_S=300

# ── Gmail demo backend (demo only; never used by the evaluation) ─────────────
# MAIL_BACKEND=gmail
# GMAIL_ALLOWED_RECIPIENTS=444testmail@gmail.com,attacker-demo@example.com
# GMAIL_DIRECTORY=sara.khan=colleague@gmail.com,security=demo@gmail.com   # which real mailbox plays each colleague
# AGENT_MAX_TURNS=12        # Mailbox demo only; the evaluation keeps the frozen 6
# DOCUMENTS_DIR=rag/documents_demo   # demo corpus (adds a fictional compensation sheet); FAISS_INDEX_PATH=.faiss_demo
