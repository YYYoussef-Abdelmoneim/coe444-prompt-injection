.env
.data/
.venv/
__pycache__/
*.pyc
logs/*.jsonl
# Runs stay local so the repo doesn't fill with every sweep. A log that backs a
# reported number is evidence, so it is tracked by name. The 27 Sep dev baseline
# is the one METHODOLOGY sections 4 and 5 cite. Its scored file is tracked too,
# because cli.py report reads scored logs and nothing can re-score a raw one yet.
!logs/run-20260927T082229Z.jsonl
!logs/scored-20260927T082229Z.jsonl
# detector-v3a on the dev excerpt set: backs the threshold and the dev FNR/FPR.
!logs/detector-20261012T203528Z.jsonl
# LLMail-Inject exploratory baseline (Step D): backs results/llmail_baseline.md.
!logs/run-20261012T202019Z.jsonl
!logs/scored-20261012T202019Z.jsonl
# Pre-registered detector checks (Step E): the variance check and the out-of-sample run.
!logs/detector-variance-20261012T211059Z.jsonl
!logs/detector-external-20261012T215514Z.jsonl
results/*.csv
results/*.json
.DS_Store
.hf-cache/
scripts/activate.sh

# LLMail-Inject raw downloads (MIT, ~1.7 GB upstream). Only the converted sample
# attacks/external_llmail.json is tracked; regenerate it with attacks/convert_llmail.py.
.data/llmail_inject/
